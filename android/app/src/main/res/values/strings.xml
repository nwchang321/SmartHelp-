    <string name="home_section_title">How this helps</string>
    <string name="home_section_body">Made to reduce confusion, not add more steps.</string>
    <string name="home_card_one_title">Say the task naturally</string>
    <string name="home_card_one_body">You can ask for help like "send a photo" or "turn on Wi-Fi".</string>
    <string name="home_card_two_title">Follow one clear target</string>
    <string name="home_card_two_body">A highlight appears on the right button or text field so each step feels obvious.</string>
    <string name="home_card_three_title">Privacy stays in your hands</string>
    <string name="home_card_three_body">Nothing starts until you allow it, and you can stop assistance any time.</string>
    <string name="home_footer_title">Best for common tasks</string>
    <string name="home_footer_body">Messages, calls, settings, photos, and other day-to-day actions on Android.</string>

