    <!-- Permission Request -->
    <string name="permission_mic_title">Microphone Permission Required</string>
    <string name="permission_mic_message">SmartHelp+ needs microphone access so it can hear your request when you tap the mic.</string>
    <string name="permission_mic_settings_message">Microphone access was denied. You can enable it in Settings now, or continue without voice input.</string>
    <string name="permission_mic_denied">Microphone permission is required for voice help.</string>
    <string name="permission_mic_allow">Allow microphone</string>
    <string name="permission_mic_skip">Continue without mic</string>
    <string name="permission_open_settings">Open Settings</string>
    <string name="permission_overlay_title">Overlay Permission Required</string>
    <string name="permission_overlay_message">SmartHelp+ needs permission to display over other apps so it can guide you while you use your phone. Tap \"Open Settings\" and enable \"Allow display over other apps\".</string>
    <string name="permission_screen_title">Screen Capture Permission Required</string>
    <string name="permission_screen_message">SmartHelp+ needs to see your screen to guide you step by step. Tap \"Allow\" on the next screen to continue.</string>
    <string name="perm_req_title">Android will now ask for permission</string>
    <string name="perm_req_body">Please tap \'Allow\' on the next screen. This lets SmartHelp+ see your screen to help you.</string>
    <string name="perm_req_tip">👆 Look for the word Allow and tap it.</string>
    <string name="perm_req_note">You can remove this permission any time in Settings.</string>

