<?xml version="1.0" encoding="utf-8"?>
<!-- PERMISSION EDUCATION — Clean iOS-inspired layout -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Thin purple accent bar -->
        <View
            android:id="@+id/viewPermTopBar"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="@drawable/btn_primary_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_primary"
            android:contentDescription="Back"
            app:layout_constraintTop_toBottomOf="@id/viewPermTopBar"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Illustration -->
        <ImageView
            android:id="@+id/imgPermIllustration"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Illustration"
            android:scaleType="centerInside"
            app:tint="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Headline -->
        <TextView
            android:id="@+id/txtPermTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:text="@string/perm_edu_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textAlignment="center"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="1.2"
            app:layout_constraintTop_toBottomOf="@id/imgPermIllustration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Explanation card — iOS grouped style -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPermPoints"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface"
            app:layout_constraintTop_toBottomOf="@id/txtPermTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_edu_point1"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.4"
                    android:paddingVertical="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_edu_point2"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.4"
                    android:paddingVertical="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginVertical="4dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_edu_point3"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.4"
                    android:paddingVertical="6dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Privacy badge -->
        <TextView
            android:id="@+id/txtPrivacyBadgePerm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/perm_edu_badge"
            android:textSize="13sp"
            android:textColor="#059669"
            android:paddingVertical="6dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_privacy_badge"
            app:layout_constraintTop_toBottomOf="@id/cardPermPoints"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Continue button — purple capsule -->
        <Button
            android:id="@+id/btnPermContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="@string/btn_continue"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary"
            android:background="@drawable/btn_primary_bg"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/txtPrivacyBadgePerm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Learn more link -->
        <TextView
            android:id="@+id/txtLearnPrivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/btn_learn_privacy"
            android:textSize="15sp"
            android:textColor="@color/primary"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnPermContinue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
