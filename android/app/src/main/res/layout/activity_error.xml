<?xml version="1.0" encoding="utf-8"?>
<!-- ERROR STATE — Clean iOS-inspired minimal layout -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <!-- Error illustration -->
    <ImageView
        android:id="@+id/imgErrorIllustration"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@android:drawable/ic_menu_upload"
        android:contentDescription="Error illustration"
        android:scaleType="centerInside"
        app:tint="@color/text_hint"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.28" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtErrorTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/error_no_internet_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:textAlignment="center"
        android:letterSpacing="-0.02"
        app:layout_constraintTop_toBottomOf="@id/imgErrorIllustration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Body -->
    <TextView
        android:id="@+id/txtErrorBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="8dp"
        android:text="@string/error_no_internet_body"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintTop_toBottomOf="@id/txtErrorTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Try Again — purple capsule -->
    <Button
        android:id="@+id/btnTryAgain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minHeight="56dp"
        android:text="@string/btn_try_again"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_on_primary"
        android:background="@drawable/btn_primary_bg"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toTopOf="@id/btnTypeInstead"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Type instead — outlined capsule -->
    <Button
        android:id="@+id/btnTypeInstead"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:minHeight="50dp"
        android:text="@string/btn_type_instead"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:background="@drawable/btn_secondary_bg"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
