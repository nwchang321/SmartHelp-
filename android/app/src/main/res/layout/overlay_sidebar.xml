<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_sidebar"
    android:elevation="8dp">

    <!-- App logo -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_overlay_icon_circle">

        <ImageView
            android:id="@+id/imgSidebarLogo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="SmartHelp+"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />
    </FrameLayout>

    <!-- Step badge (shown when task active) -->
    <TextView
        android:id="@+id/txtSidebarStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_overlay_status_pill"
        android:gravity="center"
        android:minWidth="28dp"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Expand hint arrow -->
    <ImageView
        android:id="@+id/imgSidebarExpand"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Expand"
        android:src="@drawable/ic_chevron_right"
        app:tint="#80FFFFFF" />

    <!-- New guidance indicator (pulsing dot) -->
    <View
        android:id="@+id/viewSidebarPulse"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_overlay_status_pill"
        android:visibility="gone" />

</LinearLayout>
