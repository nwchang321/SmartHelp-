<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="160dp"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/layoutMicTextInput"
        android:layout_width="304dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:background="@drawable/bg_overlay_input_bar_chat"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnMicTextClose"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_mic_text_close_button"
            android:contentDescription="Close typed message input"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="#B91C1C" />

        <EditText
            android:id="@+id/etMicTextInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Type a message"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#0A2342"
            android:textColorHint="#7A8794"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnMicTextSend"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_mic_float"
            android:contentDescription="Send typed message"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutMicControls"
        android:layout_width="match_parent"
        android:layout_height="142dp"
        android:layout_gravity="bottom|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnMicKeyboardInput"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_mic_keyboard_button"
            android:contentDescription="Type message"
            android:elevation="8dp"
            android:padding="16dp"
            android:scaleType="center"
            android:src="@drawable/ic_keyboard"
            app:tint="#0A2342" />

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="142dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/micIdleHalo"
                android:layout_width="122dp"
                android:layout_height="122dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_idle_halo"
                android:alpha="0.45" />

            <View
                android:id="@+id/micRing3"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_ring"
                android:alpha="0" />

            <View
                android:id="@+id/micRing2"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_ring"
                android:alpha="0" />

            <View
                android:id="@+id/micRing1"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_ring"
                android:alpha="0" />

            <ImageView
                android:id="@+id/imgMicFloat"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_float"
                android:contentDescription="Microphone"
                android:elevation="0dp"
                android:translationZ="0dp"
                android:stateListAnimator="@null"
                android:outlineProvider="background"
                android:clipToOutline="true"
                android:padding="21dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnMicChatHistory"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_mic_keyboard_button"
            android:contentDescription="Chat history"
            android:elevation="8dp"
            android:padding="16dp"
            android:scaleType="center"
            android:src="@drawable/ic_chat_dark" />
    </LinearLayout>

    <!-- Hint text below mic -->
    <TextView
        android:id="@+id/txtMicHint"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bg_mic_hint_pill"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="38dp"
        android:minWidth="132dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="Hold to speak, or tap keyboard"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:alpha="0" />

</FrameLayout>
