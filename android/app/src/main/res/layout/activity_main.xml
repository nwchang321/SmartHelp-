<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero_gradient">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollWelcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutWelcomeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════════════════════════════
                 HERO SECTION
            ═══════════════════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="44dp"
                android:paddingEnd="24dp"
                android:paddingBottom="40dp">

                <!-- Top bar: settings (left) ·· connection status (right) -->
                <LinearLayout
                    android:id="@+id/layoutWelcomeTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnSettings"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_translucent_pill"
                        android:contentDescription="@string/cd_settings"
                        android:padding="10dp"
                        android:src="@drawable/ic_settings"
                        app:tint="#0A2342" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/layoutConnStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_translucent_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <View
                            android:id="@+id/viewConnDot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/circle_dot_green" />

                        <TextView
                            android:id="@+id/txtConnStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="..."
                            android:textColor="#0A2342"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Greeting — centred -->
                <TextView
                    android:id="@+id/txtGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/home_greeting_morning_clean"
                    android:textColor="#0A2342"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <!-- Subtitle — centred -->
                <TextView
                    android:id="@+id/txtSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:breakStrategy="balanced"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="3"
                    android:text="Try asking me to open apps, find photos, or change settings."
                    android:textColor="#1565C0"
                    android:textSize="15sp" />

                <!-- ── Mic orb ── -->
                <FrameLayout
                    android:id="@+id/frameStartOrb"
                    android:layout_width="188dp"
                    android:layout_height="188dp"
                    android:layout_marginTop="96dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Outer pulse ring (animated scale + alpha) -->
                    <View
                        android:id="@+id/viewStartOrbRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:alpha="0.45"
                        android:background="@drawable/circle_white_ring" />

                    <!-- Main orb — circular MaterialCardView -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStartAssistant"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="70dp"
                        app:cardElevation="24dp"
                        app:cardMaxElevation="30dp"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false"
                        app:strokeColor="#331565C0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:id="@+id/layoutStartSurface"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_welcome_cta_idle"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:src="@drawable/ic_mic"
                                app:tint="#FFFFFF" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- Label below orb -->
                <TextView
                    android:id="@+id/txtStartLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/home_primary_idle"
                    android:textColor="#0A2342"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStartHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:text="@string/home_primary_hint_idle"
                    android:textColor="#1565C0"
                    android:textSize="14sp" />

                <!-- Active status pill (shown when service running) -->
                <LinearLayout
                    android:id="@+id/layoutStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_translucent_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/circle_dot_green" />

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/status_active"
                        android:textColor="#0A2342"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>


            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
